# 本地开发连接 GitHub 时使用；线上 OAuth 配置在 Cloudflare Secrets。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CAMPUS_PUBLIC_ORIGIN=http://127.0.0.1:5173
CAMPUS_API_PORT=8787
CAMPUS_WORK_OWNER=DreamGallery
CAMPUS_WORK_REPO=Idoly-localify-translations
CAMPUS_WORK_BRANCH=collaboration
CAMPUS_WEB_DATA=/absolute/path/to/Idoly-Viewer/public
CAMPUS_STORY_ROOT=/absolute/path/to/Idoly-localify-translations/story/ai
CAMPUS_ADV_ROOT=/absolute/path/to/Hoshimi-Adv/Resource

# Optional: Python executable with requirements-r2.txt installed for local media decoding.
IDOLY_PYTHON=python3
