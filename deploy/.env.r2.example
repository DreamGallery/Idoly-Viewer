# Docker updater only. Scope the S3 token to the existing game-resource bucket.
IDOLY_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
IDOLY_R2_BUCKET=YOUR_BUCKET_NAME
IDOLY_R2_PREFIX=idoly-v1
# Optional HTTPS resource origin, without the prefix; blank keeps media on the Worker.
IDOLY_R2_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GitHub token: Contents read for source/translation repositories; Actions read
# for MasterDB artifacts. Never use an OAuth user's session token here.
IDOLY_GITHUB_TOKEN=
IDOLY_SOURCE_REPO=DreamGallery/Hoshimi-Adv
IDOLY_SOURCE_BRANCH=main
IDOLY_TRANSLATION_REPO=DreamGallery/Idoly-localify-translations
IDOLY_TRANSLATION_BRANCH=main
IDOLY_MASTER_REPO=MalitsPlus/ipr-master-diff
IDOLY_MASTER_REF=main

# Octo resources only. No game login or MasterDB extraction is performed.
IDOLY_OCTO_URL=
IDOLY_OCTO_APP_ID=
IDOLY_OCTO_VERSION=
IDOLY_OCTO_CLIENT_SECRET_KEY=
# Set ONE of the two following values; leave the other empty.
# PASSPHRASE: original text value; the updater derives a SHA-256 AES key.
# KEY_HEX: already-derived AES key, 32/48/64 hex digits (0-9, a-f), no 0x prefix.
IDOLY_OCTO_AES_PASSPHRASE=
IDOLY_OCTO_AES_KEY_HEX=
IDOLY_UNITY_VERSION=2022.3.57f1

IDOLY_UPDATE_INTERVAL=21600
IDOLY_DOWNLOAD_WORKERS=2
IDOLY_UPLOAD_WORKERS=4

# Dialogue encoding: flac (lossless level 8), mp3 or aac (AAC-LC in .m4a).
# Select BEFORE the first start with this feature. Saved in /runtime/voice-encoding.json.
# Later starts must match the saved choice, or leave both values empty to reuse it.
# Songs remain FLAC. Bitrate is ignored for FLAC; lossy choices: 48/64/80/96/128/192 kbps.
IDOLY_VOICE_CODEC=flac
IDOLY_VOICE_BITRATE=96
