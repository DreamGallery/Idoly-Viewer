{
  "name": "idoly-story-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:api": "node server/local.mjs",
    "test:api": "node --test server/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:workbench": "esbuild src/workbench/workflow.test.ts src/workbench/export.test.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outdir=.test-build && node --test .test-build/*.js",
    "dev:cloudflare": "wrangler dev --port 8788",
    "build:cloudflare": "node scripts/build_cloudflare.mjs && wrangler deploy --dry-run",
    "test:cloudflare": "node --test cloudflare/*.test.mjs",
    "data:build": "python3 scripts/build-idoly-data.py",
    "data:package": "node scripts/package-idoly-resources.mjs",
    "test:corpus": "python3 scripts/verify-toolkit-merge.py && node scripts/verify-idoly-data.mjs",
    "index:build": "python3 -m idoly_story_index.build",
    "test:index": "python3 -m unittest discover -s tests -p test_idoly_index.py -v",
    "test:card-filters": "esbuild src/card-filters.test.ts --bundle --platform=node --format=esm --outfile=.test-build/card-filters.test.js && node --test .test-build/card-filters.test.js",
    "test:updates": "python3 -m unittest discover -s tests -p test_idoly_text_updates.py -v && esbuild src/text-updates.test.ts --bundle --platform=node --format=esm --outfile=.test-build/text-updates.test.js && node --test .test-build/text-updates.test.js",
    "dev:api:github": "node server/github.mjs",
    "test:nas": "python3 -m unittest discover -s tests -p test_nas_pipeline.py -v"
  },
  "dependencies": {
    "@ibm/plex-sans": "^1.1.0",
    "@ibm/plex-sans-jp": "^3.0.0",
    "@ibm/plex-sans-sc": "^1.1.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.344.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "wrangler": "^4.136.2"
  }
}
